{
  "name": "@open-mercato/soanas-desktop",
  "version": "0.7.0",
  "license": "UNLICENSED",
  "private": true,
  "description": "Soanas desktop shell + local runtime foundations (Electron wrapper over store-local services)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node watch.mjs",
    "test": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": [
        "./src/*.ts"
      ],
      "default": "./dist/*.js"
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JhonyGalerani/open-mercato",
    "directory": "packages/soanas-desktop"
  }
}
