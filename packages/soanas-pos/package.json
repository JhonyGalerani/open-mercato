{
  "name": "@open-mercato/soanas-pos",
  "version": "0.7.0",
  "license": "UNLICENSED",
  "private": true,
  "description": "Soanas point of sale — terminals, POS transactions, tenders and the completion saga",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node watch.mjs",
    "test": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": [
        "./src/*.ts"
      ],
      "default": "./dist/*.js"
    },
    "./*/*": {
      "types": [
        "./src/*/*.ts"
      ],
      "default": "./dist/*/*.js"
    },
    "./*/*/*": {
      "types": [
        "./src/*/*/*.ts"
      ],
      "default": "./dist/*/*/*.js"
    },
    "./*/*/*/*": {
      "types": [
        "./src/*/*/*/*.ts"
      ],
      "default": "./dist/*/*/*/*.js"
    },
    "./*/*/*/*/*": {
      "types": [
        "./src/*/*/*/*/*.ts"
      ],
      "default": "./dist/*/*/*/*/*.js"
    }
  },
  "dependencies": {
    "@open-mercato/core": "workspace:*",
    "@open-mercato/soanas-cash": "workspace:*",
    "@open-mercato/soanas-core": "workspace:*",
    "@open-mercato/ui": "workspace:*"
  },
  "peerDependencies": {
    "@mikro-orm/core": "^7.0.14",
    "@mikro-orm/postgresql": "^7.0.14",
    "@open-mercato/shared": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": ">=3.23.0"
  },
  "devDependencies": {
    "@mikro-orm/core": "^7.1.8",
    "@mikro-orm/postgresql": "^7.1.8",
    "@open-mercato/shared": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jest": "^30.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-jest": "^29.4.12",
    "typescript": "7.0.2",
    "zod": "4.4.3"
  }
}
